# Local Postgres (docker-compose reads this file).
# POSTGRES_PASSWORD has no default in docker-compose.yaml on purpose — a literal
# fallback there is a credential committed to the repository.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=zeitmail
POSTGRES_PORT=5432

# Must match the values above.
DATABASE_URL=postgresql://postgres:choose-a-local-password@localhost:5432/zeitmail

# Required. The app refuses to start in production without these.
# openssl rand -hex 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated, listed explicitly. Do not use wildcards: a trusted origin can
# drive auth callbacks and is exempt from CSRF checks.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Required. Encrypts mailbox credentials and OAuth refresh tokens at rest.
# Changing this makes every stored credential undecryptable — see
# apps/web/scripts/encrypt-existing-tokens.ts before rotating.
# openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private registry token for @hugeicons-pro (required by `bun install`).
NPM_CONFIG_HUGEICONS_KEY=
